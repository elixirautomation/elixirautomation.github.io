package-lock.json

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local caches and tooling
.vite/
.playwright-mcp/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.local
